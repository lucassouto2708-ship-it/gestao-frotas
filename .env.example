# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# --- Limpeza automática de fotos antigas (opcional) ---
# Só no servidor (Vercel). NUNCA coloque o prefixo NEXT_PUBLIC_ nestas duas.
# Supabase > Project Settings > API Keys > Secret keys (a chave "secret", não a publishable)
SUPABASE_SERVICE_ROLE_KEY=
# Texto aleatório longo (ex.: 32 letras e números). A Vercel o envia ao chamar /api/limpeza-fotos.
CRON_SECRET=
